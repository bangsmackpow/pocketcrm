{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketcrm",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_NAME": "PocketCRM",
    "BETTER_AUTH_URL": "https://pocketcrm.curtislamasters.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocketcrm-db",
      "database_id": "c63bee65-0dcd-4268-a2fb-0a4ef39970e9",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "pocketcrm-storage"
    }
  ]
}
